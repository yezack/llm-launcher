{
  "_comment": "复制本文件为 config.json 后按需修改。当前仅 vLLM 引擎：profile 的 engine=vllm，参数见顶层 vllm 段（用 python -m vllm 启动）。",
  "base_dir": "D:/path/to/models",
  "vllm": {
    "executable": "../vllm/venv/Scripts/python.exe",
    "module": "vllm.entrypoints.cli.main",
    "common_args": {
      "host": "127.0.0.1",
      "port": 8000,
      "gpu_memory_utilization": 0.945,
      "kv_cache_dtype": "fp8",
      "quantization": "modelopt",
      "trust_remote_code": true,
      "enforce_eager": true,
      "served_model_name": "qwen3.8-27b"
    },
    "env": {
      "PYTHONUTF8": "1",
      "VLLM_HOST_IP": "127.0.0.1"
    }
  },
  "profiles": [
    {
      "name": "vLLM · 100K 单路",
      "engine": "vllm",
      "description": "100K 单路（fp8 KV）。适合单个长上下文任务。",
      "alias": "model-100k",
      "model": "D:/path/to/models/your-model",
      "args": {
        "max_model_len": 100000,
        "max_num_seqs": 1
      }
    },
    {
      "name": "vLLM · 48K 双路",
      "engine": "vllm",
      "description": "48K × 2 并发（总 100K token）。适合两个任务并行。",
      "alias": "model-50kx2",
      "model": "D:/path/to/models/your-model",
      "args": {
        "max_model_len": 48000,
        "max_num_seqs": 2
      }
    },
    {
      "name": "vLLM · 32K 三路",
      "engine": "vllm",
      "description": "32K × 3 并发（总 96K token）。适合三个任务并行。",
      "alias": "model-32kx3",
      "model": "D:/path/to/models/your-model",
      "args": {
        "max_model_len": 32000,
        "max_num_seqs": 3
      }
    }
  ]
}
