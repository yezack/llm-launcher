# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---- 打包 / 构建产物 ----
build/
dist/
*.spec

# ---- 运行日志 ----
logs/

# ---- 测速脚本 / 日志(本地测试工具, 不入库) ----
bench_*.log
bench_*.py

# ---- 本地配置(含个人绝对路径, 请复制 config.example.json 为 config.json 后自行修改) ----
config.json

# ---- llama.cpp 二进制运行时(体积大, 从 llama.cpp release 下载后放入 bin/) ----
bin/

# ---- 模型配置目录(每模型一个文件, 本地; 仅模板文件入库) ----
config.d/*
!config.d/example-model.json
